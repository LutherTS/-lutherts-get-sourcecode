{
  "name": "@lutherts/get-sourcecode",
  "version": "0.1.26",
  "description": "Retrieves the ESLint-generated SourceCode object of a JS/TS/JSX/TSX file.",
  "keywords": [
    "ast",
    "comments",
    "eslint",
    "sourcecode"
  ],
  "license": "UNLICENSED",
  "author": "Luther Tchofo Safo <luther@tchofo-safo-portfolio.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LutherTS/-lutherts-get-sourcecode.git"
  },
  "files": [
    "tsdown/library/index.mjs",
    "get-sourcecode.public.d.ts",
    "comments.config.public.json"
  ],
  "type": "module",
  "main": "tsdown/library/index.mjs",
  "types": "get-sourcecode.public.d.ts",
  "scripts": {
    "types": "tsc",
    "doc": "comvar doc",
    "api": "api-extractor run",
    "build": "tsdown",
    "test": "node --test",
    "lint": "oxlint",
    "prepare": "npm run types && npm run doc && npm run api && npm run build && npm run test && npm run lint"
  },
  "dependencies": {
    "@lutherts/error-handling": "^0.1.25",
    "eslint": "^10.3.0",
    "typescript-eslint": "^8.59.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsdown": "^0.22.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
