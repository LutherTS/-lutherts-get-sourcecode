{
  "name": "get-sourcecode",
  "version": "0.1.4",
  "description": "Retrieves the ESLint-generated SourceCode object of a JS/TS/JSX/TSX file.",
  "keywords": [
    "sourcecode",
    "eslint",
    "ast",
    "comments"
  ],
  "license": "MIT",
  "author": "Luther Tchofo Safo <luther@tchofo-safo-portfolio.me>",
  "type": "module",
  "main": "source/library/index.js",
  "types": "declarations/source/library/index.d.ts",
  "files": [
    "comment-variables",
    "declarations",
    "source",
    "comments.config.js",
    "comments.config.json",
    "comments.config.mjs",
    "comments.config.public.json",
    "comments.config.public.mjs"
  ],
  "scripts": {
    "types": "tsc",
    "test": "node --test",
    "prepare": "npm run types && npm run test"
  },
  "dependencies": {
    "eslint": "^10.3.0",
    "typescript-eslint": "^8.59.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
