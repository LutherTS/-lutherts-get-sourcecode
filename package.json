{
  "name": "get-sourcecode",
  "version": "0.1.7",
  "description": "Retrieves the ESLint-generated SourceCode object of a JS/TS/JSX/TSX file.",
  "keywords": [
    "sourcecode",
    "eslint",
    "ast",
    "comments"
  ],
  "license": "UNLICENSED",
  "author": "Luther Tchofo Safo <luther@tchofo-safo-portfolio.me>",
  "type": "module",
  "main": "source/library/index.js",
  "types": "get-sourcecode.d.ts",
  "files": [
    "comment-variables",
    "source",
    "comments.config.js",
    "comments.config.json",
    "comments.config.mjs",
    "comments.config.public.json",
    "comments.config.public.mjs",
    "get-sourcecode.d.ts",
    "get-sourcecode.public.d.ts"
  ],
  "scripts": {
    "types": "tsc",
    "doc": "npx comment-variables doc",
    "api": "api-extractor run",
    "test": "node --test",
    "prepare": "npm run types && npm run doc && npm run api && npm run test"
  },
  "dependencies": {
    "eslint": "^10.3.0",
    "typescript-eslint": "^8.59.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "comment-variables": "file:packages/dev-dependencies/comment-variables-2.5.0.tgz",
    "comment-variables-resolve-config": "file:packages/dev-dependencies/comment-variables-resolve-config-2.5.0.tgz",
    "find-all-imports": "file:packages/dev-dependencies/find-all-imports-0.1.7.tgz",
    "get-sourcecode": "file:packages/dev-dependencies/get-sourcecode-0.1.7.tgz",
    "typescript": "^6.0.3"
  }
}
